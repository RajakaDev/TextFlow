-- ============================================================
-- Supplier & Purchase Management - MySQL schema
-- ============================================================
-- This module OWNS: suppliers, purchases, purchase_items, purchase_returns
-- This module USES (reads/adjusts stock only): products, users
--
-- The `products` and `users` stub tables below are placeholders so this
-- module can run standalone before it's merged with the real Product
-- (Anurasiri) and User/Auth (Fernando) modules. When merging, DROP these
-- two stub tables and let the real ones (with the same column names used
-- here: products.product_id/name/barcode/current_stock,
-- users.user_id) take over - nothing else in this module needs to change.
-- ============================================================

CREATE DATABASE IF NOT EXISTS pos_system;
USE pos_system;

-- ---------- stub tables (delete once merged with the real modules) ----------

CREATE TABLE IF NOT EXISTS products (
    product_id     INT AUTO_INCREMENT PRIMARY KEY,
    name           VARCHAR(150) NOT NULL,
    barcode        VARCHAR(50) UNIQUE,
    current_stock  INT NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS users (
    user_id  INT AUTO_INCREMENT PRIMARY KEY,
    username VARCHAR(100) NOT NULL
);

-- a couple of sample rows so the app has something to work with immediately
