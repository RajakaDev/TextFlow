-- ---------- this module's own tables ----------

CREATE TABLE IF NOT EXISTS suppliers (
    supplier_id     INT AUTO_INCREMENT PRIMARY KEY,
    name            VARCHAR(150) NOT NULL,
    contact_person  VARCHAR(150),
    phone           VARCHAR(30),
    email           VARCHAR(150),
    address         VARCHAR(255),
    is_active       TINYINT(1) NOT NULL DEFAULT 1,
    created_at      DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS purchases (
    purchase_id           INT AUTO_INCREMENT PRIMARY KEY,
    supplier_id           INT NOT NULL,
    recorded_by_user_id   INT NOT NULL,
    purchase_date         DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    status                ENUM('Draft','Confirmed','Cancelled') NOT NULL DEFAULT 'Draft',
    total_amount          DECIMAL(14,2) NOT NULL DEFAULT 0,
    notes                 VARCHAR(255),
    CONSTRAINT fk_purchase_supplier FOREIGN KEY (supplier_id) REFERENCES suppliers(supplier_id),
    CONSTRAINT fk_purchase_user FOREIGN KEY (recorded_by_user_id) REFERENCES users(user_id)
);

CREATE TABLE IF NOT EXISTS purchase_items (
    purchase_item_id  INT AUTO_INCREMENT PRIMARY KEY,
    purchase_id       INT NOT NULL,
    product_id        INT NOT NULL,
    quantity          INT NOT NULL,
    unit_cost         DECIMAL(14,2) NOT NULL,
    CONSTRAINT fk_item_purchase FOREIGN KEY (purchase_id) REFERENCES purchases(purchase_id) ON DELETE CASCADE,
    CONSTRAINT fk_item_product FOREIGN KEY (product_id) REFERENCES products(product_id)
);

CREATE TABLE IF NOT EXISTS purchase_returns (
    purchase_return_id  INT AUTO_INCREMENT PRIMARY KEY,
    purchase_item_id    INT NOT NULL,
    product_id          INT NOT NULL,
    quantity_returned   INT NOT NULL,
    unit_cost           DECIMAL(14,2) NOT NULL,
    reason               VARCHAR(255),
    return_date          DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_return_item FOREIGN KEY (purchase_item_id) REFERENCES purchase_items(purchase_item_id),
    CONSTRAINT fk_return_product FOREIGN KEY (product_id) REFERENCES products(product_id)
);

CREATE INDEX idx_purchases_date ON purchases(purchase_date);
CREATE INDEX idx_purchases_supplier ON purchases(supplier_id);
CREATE INDEX idx_purchase_items_purchase ON purchase_items(purchase_id);
