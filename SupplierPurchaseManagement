using System;
using System.Linq;
using System.Windows.Forms;
using SupplierPurchaseManagement.DAO;
using SupplierPurchaseManagement.Models;

namespace SupplierPurchaseManagement.Forms
{
    public class PurchaseHistoryForm : Form
    {
        private readonly PurchaseDAO _purchaseDAO = new PurchaseDAO();
        private readonly SupplierDAO _supplierDAO = new SupplierDAO();

        private DateTimePicker dtFrom, dtTo;
        private ComboBox cmbSupplierFilter;
        private Button btnFilter;
        private DataGridView gridHistory, gridItems;
        private Label lblGrandTotal;

        public PurchaseHistoryForm()
        {
            Text = "Purchase History & Report";
            Width = 1000;
            Height = 650;
            StartPosition = FormStartPosition.CenterScreen;

            BuildUi();
            LoadSuppliers();
            LoadHistory();
        }

        private void BuildUi()
        {
            var lblFrom = new Label { Text = "From:", Left = 20, Top = 18, Width = 50 };
            dtFrom = new DateTimePicker { Left = 70, Top = 15, Width = 130, Value = DateTime.Now.AddMonths(-1) };

            var lblTo = new Label { Text = "To:", Left = 210, Top = 18, Width = 30 };
            dtTo = new DateTimePicker { Left = 245, Top = 15, Width = 130, Value = DateTime.Now };

            var lblSupplier = new Label { Text = "Supplier:", Left = 390, Top = 18, Width = 60 };
            cmbSupplierFilter = new ComboBox { Left = 455, Top = 15, Width = 220, DropDownStyle = ComboBoxStyle.DropDownList };

            btnFilter = new Button { Text = "Apply Filter", Left = 690, Top = 13, Width = 120, Height = 28 };
            btnFilter.Click += (s, e) => LoadHistory();

            gridHistory = new DataGridView
            {
                Left = 20,
                Top = 55,
                Width = 940,
                Height = 260,
                ReadOnly = true,
                AllowUserToAddRows = false,
                SelectionMode = DataGridViewSelectionMode.FullRowSelect,
                MultiSelect = false,
                AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill
            };
            gridHistory.SelectionChanged += GridHistory_SelectionChanged;

            var lblItemsHeader = new Label { Text = "Items for selected purchase:", Left = 20, Top = 325, Width = 250, Font = new System.Drawing.Font("Segoe UI", 9, System.Drawing.FontStyle.Bold) };

            gridItems = new DataGridView
            {
                Left = 20,
                Top = 350,
                Width = 940,
                Height = 200,
                ReadOnly = true,
                AllowUserToAddRows = false,
                AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill
            };

            lblGrandTotal = new Label
            {
                Text = "Total confirmed purchases in range: 0.00",
                Left = 20,
                Top = 560,
                Width = 500,
                Font = new System.Drawing.Font("Segoe UI", 10, System.Drawing.FontStyle.Bold)
            };

            Controls.AddRange(new Control[]
            {
                lblFrom, dtFrom, lblTo, dtTo, lblSupplier, cmbSupplierFilter, btnFilter,
                gridHistory, lblItemsHeader, gridItems, lblGrandTotal
            });
        }

        private void LoadSuppliers()
        {
            var suppliers = _supplierDAO.GetAllSuppliers(includeInactive: true).ToList();
            suppliers.Insert(0, new Supplier { SupplierId = 0, Name = "(All Suppliers)" });
            cmbSupplierFilter.DataSource = suppliers;
            cmbSupplierFilter.DisplayMember = "Name";
            cmbSupplierFilter.ValueMember = "SupplierId";
        }

        private void LoadHistory()
        {
            int? supplierId = (cmbSupplierFilter.SelectedItem as Supplier)?.SupplierId;
            if (supplierId == 0) supplierId = null;

            var purchases = _purchaseDAO.GetPurchaseHistory(dtFrom.Value.Date, dtTo.Value.Date.AddDays(1).AddSeconds(-1), supplierId);
            gridHistory.DataSource = null;
            gridHistory.DataSource = purchases;

            if (gridHistory.Columns["PurchaseId"] != null) gridHistory.Columns["PurchaseId"].HeaderText = "ID";
            if (gridHistory.Columns["SupplierId"] != null) gridHistory.Columns["SupplierId"].Visible = false;
            if (gridHistory.Columns["SupplierName"] != null) gridHistory.Columns["SupplierName"].HeaderText = "Supplier";
            if (gridHistory.Columns["RecordedByUserId"] != null) gridHistory.Columns["RecordedByUserId"].HeaderText = "Recorded By (User ID)";
            if (gridHistory.Columns["PurchaseDate"] != null) gridHistory.Columns["PurchaseDate"].HeaderText = "Date";
            if (gridHistory.Columns["TotalAmount"] != null) gridHistory.Columns["TotalAmount"].HeaderText = "Total";
            if (gridHistory.Columns["Items"] != null) gridHistory.Columns["Items"].Visible = false;

            decimal grandTotal = _purchaseDAO.GetTotalPurchasesInRange(dtFrom.Value.Date, dtTo.Value.Date.AddDays(1).AddSeconds(-1));
            lblGrandTotal.Text = $"Total confirmed purchases in range: {grandTotal:N2}";
        }

        private void GridHistory_SelectionChanged(object sender, EventArgs e)
        {
            if (gridHistory.CurrentRow?.DataBoundItem is not Purchase purchase)
            {
                gridItems.DataSource = null;
                return;
            }

            var items = _purchaseDAO.GetItemsForPurchase(purchase.PurchaseId);
            gridItems.DataSource = null;
            gridItems.DataSource = items;

            if (gridItems.Columns["PurchaseItemId"] != null) gridItems.Columns["PurchaseItemId"].Visible = false;
            if (gridItems.Columns["PurchaseId"] != null) gridItems.Columns["PurchaseId"].Visible = false;
            if (gridItems.Columns["ProductId"] != null) gridItems.Columns["ProductId"].Visible = false;
            if (gridItems.Columns["ProductName"] != null) gridItems.Columns["ProductName"].HeaderText = "Product";
            if (gridItems.Columns["UnitCost"] != null) gridItems.Columns["UnitCost"].HeaderText = "Unit Cost";
            if (gridItems.Columns["LineTotal"] != null) gridItems.Columns["LineTotal"].HeaderText = "Line Total";
        }
    }
}

using System;
using System.Collections.Generic;
using MySql.Data.MySqlClient;
using SupplierPurchaseManagement.Data;
using SupplierPurchaseManagement.Models;

namespace SupplierPurchaseManagement.DAO
{
    public class SupplierDAO
    {
        public int AddSupplier(Supplier supplier)
        {
            const string sql = @"INSERT INTO suppliers (name, contact_person, phone, email, address, is_active, created_at)
                                  VALUES (@name, @contact, @phone, @email, @address, 1, NOW());
                                  SELECT LAST_INSERT_ID();";

            using var conn = DatabaseConnection.GetConnection();
            using var cmd = new MySqlCommand(sql, conn);
            cmd.Parameters.AddWithValue("@name", supplier.Name);
            cmd.Parameters.AddWithValue("@contact", supplier.ContactPerson ?? "");
            cmd.Parameters.AddWithValue("@phone", supplier.Phone ?? "");
            cmd.Parameters.AddWithValue("@email", supplier.Email ?? "");
            cmd.Parameters.AddWithValue("@address", supplier.Address ?? "");

            var newId = Convert.ToInt32(cmd.ExecuteScalar());
            return newId;
        }

        public List<Supplier> GetAllSuppliers(bool includeInactive = false)
        {
            var suppliers = new List<Supplier>();
            string sql = "SELECT * FROM suppliers";
            if (!includeInactive) sql += " WHERE is_active = 1";
            sql += " ORDER BY name";

            using var conn = DatabaseConnection.GetConnection();
            using var cmd = new MySqlCommand(sql, conn);
            using var reader = cmd.ExecuteReader();
            while (reader.Read())
                suppliers.Add(MapSupplier(reader));

            return suppliers;
        }

        public Supplier GetSupplierById(int supplierId)
        {
            const string sql = "SELECT * FROM suppliers WHERE supplier_id = @id";
            using var conn = DatabaseConnection.GetConnection();
            using var cmd = new MySqlCommand(sql, conn);
            cmd.Parameters.AddWithValue("@id", supplierId);
            using var reader = cmd.ExecuteReader();
            return reader.Read() ? MapSupplier(reader) : null;
        }

        public List<Supplier> SearchSuppliers(string keyword)
        {
            var suppliers = new List<Supplier>();
            const string sql = @"SELECT * FROM suppliers
                                  WHERE is_active = 1 AND (name LIKE @kw OR contact_person LIKE @kw OR phone LIKE @kw)
                                  ORDER BY name";
            using var conn = DatabaseConnection.GetConnection();
            using var cmd = new MySqlCommand(sql, conn);
            cmd.Parameters.AddWithValue("@kw", $"%{keyword}%");
            using var reader = cmd.ExecuteReader();
            while (reader.Read())
                suppliers.Add(MapSupplier(reader));
            return suppliers;
        }

        public bool UpdateSupplier(Supplier supplier)
        {
            const string sql = @"UPDATE suppliers SET name=@name, contact_person=@contact, phone=@phone,
                                  email=@email, address=@address WHERE supplier_id=@id";
            using var conn = DatabaseConnection.GetConnection();
            using var cmd = new MySqlCommand(sql, conn);
            cmd.Parameters.AddWithValue("@name", supplier.Name);
            cmd.Parameters.AddWithValue("@contact", supplier.ContactPerson ?? "");
            cmd.Parameters.AddWithValue("@phone", supplier.Phone ?? "");
            cmd.Parameters.AddWithValue("@email", supplier.Email ?? "");
            cmd.Parameters.AddWithValue("@address", supplier.Address ?? "");
            cmd.Parameters.AddWithValue("@id", supplier.SupplierId);
            return cmd.ExecuteNonQuery() > 0;
        }

        /// <summary>Soft delete - deactivate rather than hard-delete, so purchase history stays intact.</summary>
        public bool DeactivateSupplier(int supplierId)
        {
            const string sql = "UPDATE suppliers SET is_active = 0 WHERE supplier_id = @id";
            using var conn = DatabaseConnection.GetConnection();
            using var cmd = new MySqlCommand(sql, conn);
            cmd.Parameters.AddWithValue("@id", supplierId);
            return cmd.ExecuteNonQuery() > 0;
        }

        private Supplier MapSupplier(MySqlDataReader reader)
        {
            return new Supplier
            {
                SupplierId = reader.GetInt32("supplier_id"),
                Name = reader.GetString("name"),
                ContactPerson = reader["contact_person"]?.ToString(),
                Phone = reader["phone"]?.ToString(),
                Email = reader["email"]?.ToString(),
                Address = reader["address"]?.ToString(),
                IsActive = reader.GetBoolean("is_active"),
                CreatedAt = reader.GetDateTime("created_at")
            };
        }
    }
}

using System.Collections.Generic;
using MySql.Data.MySqlClient;
using SupplierPurchaseManagement.Data;

namespace SupplierPurchaseManagement.DAO
{
    /// <summary>
    /// READ-ONLY access to the `products` table, owned by the Product &amp;
    /// Category module. Per the team's responsibility map, Supplier/Purchase
    /// may USE product data (to look up a barcode when receiving stock) but
    /// must NOT own product CRUD - that stays entirely in Anurasiri's module.
    /// If the shared `products` table doesn't exist yet in your local DB,
    /// these calls will just return no results / null until it's merged in.
    /// </summary>
    public class ProductLookupDAO
    {
        public class ProductRef
        {
            public int ProductId { get; set; }
            public string Name { get; set; }
            public string Barcode { get; set; }
        }

        public ProductRef FindByBarcode(string barcode)
        {
            const string sql = "SELECT product_id, name, barcode FROM products WHERE barcode = @barcode LIMIT 1";
            using var conn = DatabaseConnection.GetConnection();
            using var cmd = new MySqlCommand(sql, conn);
            cmd.Parameters.AddWithValue("@barcode", barcode);
            using var reader = cmd.ExecuteReader();
            if (reader.Read())
            {
                return new ProductRef
                {
                    ProductId = reader.GetInt32("product_id"),
                    Name = reader.GetString("name"),
                    Barcode = reader.GetString("barcode")
                };
            }
            return null;
        }

        public List<ProductRef> SearchByName(string nameFragment)
        {
            var results = new List<ProductRef>();
            const string sql = "SELECT product_id, name, barcode FROM products WHERE name LIKE @name LIMIT 30";
            using var conn = DatabaseConnection.GetConnection();
            using var cmd = new MySqlCommand(sql, conn);
            cmd.Parameters.AddWithValue("@name", $"%{nameFragment}%");
            using var reader = cmd.ExecuteReader();
            while (reader.Read())
            {
                results.Add(new ProductRef
                {
                    ProductId = reader.GetInt32("product_id"),
                    Name = reader.GetString("name"),
                    Barcode = reader.GetString("barcode")
                });
            }
            return results;
        }

        /// <summary>
        /// Increases stock for a product after a purchase is confirmed, or
        /// decreases it after a purchase return. This is the ONE agreed
        /// exception where Purchase is allowed to touch the products table -
        /// per the team's rule ("Purchase confirmed -> Stock+", "Purchase
        /// return -> Stock-"). Everything else about products stays owned by
        /// the Product module.
        /// </summary>
        public void AdjustStock(int productId, int quantityDelta, MySqlConnection conn, MySqlTransaction tx)
        {
            const string sql = "UPDATE products SET current_stock = current_stock + @delta WHERE product_id = @id";
            using var cmd = new MySqlCommand(sql, conn, tx);
            cmd.Parameters.AddWithValue("@delta", quantityDelta);
            cmd.Parameters.AddWithValue("@id", productId);
            cmd.ExecuteNonQuery();
        }
    }
}

using System;
using System.Collections.Generic;
using MySql.Data.MySqlClient;
using SupplierPurchaseManagement.Data;
using SupplierPurchaseManagement.Models;

namespace SupplierPurchaseManagement.DAO
{
    public class PurchaseDAO
    {
        private readonly ProductLookupDAO _productLookup = new ProductLookupDAO();

        // ---------- Purchase (header) CRUD ----------

        /// <summary>Creates a new DRAFT purchase (unconfirmed, editable).</summary>
        public int StartPurchase(int supplierId, int recordedByUserId, string notes)
        {
            const string sql = @"INSERT INTO purchases (supplier_id, recorded_by_user_id, purchase_date, status, total_amount, notes)
                                  VALUES (@supplierId, @userId, NOW(), 'Draft', 0, @notes);
                                  SELECT LAST_INSERT_ID();";
            using var conn = DatabaseConnection.GetConnection();
            using var cmd = new MySqlCommand(sql, conn);
            cmd.Parameters.AddWithValue("@supplierId", supplierId);
            cmd.Parameters.AddWithValue("@userId", recordedByUserId);
            cmd.Parameters.AddWithValue("@notes", notes ?? "");
            return Convert.ToInt32(cmd.ExecuteScalar());
        }

        public Purchase GetPurchaseById(int purchaseId)
        {
            const string sql = @"SELECT p.*, s.name AS supplier_name FROM purchases p
                                  JOIN suppliers s ON s.supplier_id = p.supplier_id
                                  WHERE p.purchase_id = @id";
            using var conn = DatabaseConnection.GetConnection();
            using var cmd = new MySqlCommand(sql, conn);
            cmd.Parameters.AddWithValue("@id", purchaseId);
            using var reader = cmd.ExecuteReader();
            if (!reader.Read()) return null;

            var purchase = MapPurchase(reader);
            reader.Close();
            purchase.Items = GetItemsForPurchase(purchaseId);
            return purchase;
        }

        public List<Purchase> GetPurchaseHistory(DateTime? from = null, DateTime? to = null, int? supplierId = null)
        {
            var purchases = new List<Purchase>();
            var sql = @"SELECT p.*, s.name AS supplier_name FROM purchases p
                        JOIN suppliers s ON s.supplier_id = p.supplier_id
                        WHERE 1=1";
            if (from.HasValue) sql += " AND p.purchase_date >= @from";
            if (to.HasValue) sql += " AND p.purchase_date <= @to";
            if (supplierId.HasValue) sql += " AND p.supplier_id = @supplierId";
            sql += " ORDER BY p.purchase_date DESC";

            using var conn = DatabaseConnection.GetConnection();
            using var cmd = new MySqlCommand(sql, conn);
            if (from.HasValue) cmd.Parameters.AddWithValue("@from", from.Value);
            if (to.HasValue) cmd.Parameters.AddWithValue("@to", to.Value);
            if (supplierId.HasValue) cmd.Parameters.AddWithValue("@supplierId", supplierId.Value);

            using var reader = cmd.ExecuteReader();
            while (reader.Read())
                purchases.Add(MapPurchase(reader));

            return purchases;
        }

        /// <summary>Only Draft purchases may be modified.</summary>
        public bool UpdatePurchaseNotes(int purchaseId, string notes)
        {
            const string sql = "UPDATE purchases SET notes=@notes WHERE purchase_id=@id AND status='Draft'";
            using var conn = DatabaseConnection.GetConnection();
            using var cmd = new MySqlCommand(sql, conn);
            cmd.Parameters.AddWithValue("@notes", notes ?? "");
            cmd.Parameters.AddWithValue("@id", purchaseId);
            return cmd.ExecuteNonQuery() > 0;
        }

        /// <summary>Only Draft purchases may be deleted.</summary>
        public bool DeleteUnconfirmedPurchase(int purchaseId)
        {
            using var conn = DatabaseConnection.GetConnection();
            using var tx = conn.BeginTransaction();
            try
            {
                using (var cmd = new MySqlCommand(
                    "DELETE FROM purchase_items WHERE purchase_id=@id AND purchase_id IN (SELECT purchase_id FROM purchases WHERE purchase_id=@id AND status='Draft')",
                    conn, tx))
                {
                    cmd.Parameters.AddWithValue("@id", purchaseId);
                    cmd.ExecuteNonQuery();
                }

                int affected;
                using (var cmd = new MySqlCommand("DELETE FROM purchases WHERE purchase_id=@id AND status='Draft'", conn, tx))
                {
                    cmd.Parameters.AddWithValue("@id", purchaseId);
                    affected = cmd.ExecuteNonQuery();
                }

                tx.Commit();
                return affected > 0;
            }
            catch
            {
                tx.Rollback();
                throw;
            }
        }

        // ---------- Purchase items ----------

        public int AddItem(int purchaseId, PurchaseItem item)
        {
            const string sql = @"INSERT INTO purchase_items (purchase_id, product_id, quantity, unit_cost)
                                  VALUES (@purchaseId, @productId, @qty, @cost);
                                  SELECT LAST_INSERT_ID();";
            using var conn = DatabaseConnection.GetConnection();
            using var cmd = new MySqlCommand(sql, conn);
            cmd.Parameters.AddWithValue("@purchaseId", purchaseId);
            cmd.Parameters.AddWithValue("@productId", item.ProductId);
            cmd.Parameters.AddWithValue("@qty", item.Quantity);
            cmd.Parameters.AddWithValue("@cost", item.UnitCost);
            var newId = Convert.ToInt32(cmd.ExecuteScalar());

            RecalculateTotal(purchaseId, conn);
            return newId;
        }

        public bool UpdateItemQuantityOrCost(int purchaseItemId, int quantity, decimal unitCost)
        {
            const string sql = "UPDATE purchase_items SET quantity=@qty, unit_cost=@cost WHERE purchase_item_id=@id";
            using var conn = DatabaseConnection.GetConnection();
            int purchaseId = GetPurchaseIdForItem(purchaseItemId, conn);

            using (var cmd = new MySqlCommand(sql, conn))
            {
                cmd.Parameters.AddWithValue("@qty", quantity);
                cmd.Parameters.AddWithValue("@cost", unitCost);
                cmd.Parameters.AddWithValue("@id", purchaseItemId);
                cmd.ExecuteNonQuery();
            }

            if (purchaseId > 0) RecalculateTotal(purchaseId, conn);
            return true;
        }

        public bool RemoveItem(int purchaseItemId)
        {
            using var conn = DatabaseConnection.GetConnection();
            int purchaseId = GetPurchaseIdForItem(purchaseItemId, conn);

            using (var cmd = new MySqlCommand("DELETE FROM purchase_items WHERE purchase_item_id=@id", conn))
            {
                cmd.Parameters.AddWithValue("@id", purchaseItemId);
                cmd.ExecuteNonQuery();
            }

            if (purchaseId > 0) RecalculateTotal(purchaseId, conn);
            return true;
        }

        public List<PurchaseItem> GetItemsForPurchase(int purchaseId)
        {
            var items = new List<PurchaseItem>();
            const string sql = @"SELECT pi.*, pr.name AS product_name, pr.barcode FROM purchase_items pi
                                  LEFT JOIN products pr ON pr.product_id = pi.product_id
                                  WHERE pi.purchase_id = @id";
            using var conn = DatabaseConnection.GetConnection();
            using var cmd = new MySqlCommand(sql, conn);
            cmd.Parameters.AddWithValue("@id", purchaseId);
            using var reader = cmd.ExecuteReader();
            while (reader.Read())
            {
                items.Add(new PurchaseItem
                {
                    PurchaseItemId = reader.GetInt32("purchase_item_id"),
                    PurchaseId = reader.GetInt32("purchase_id"),
                    ProductId = reader.GetInt32("product_id"),
                    ProductName = reader["product_name"]?.ToString() ?? "(unknown product)",
                    Barcode = reader["barcode"]?.ToString(),
                    Quantity = reader.GetInt32("quantity"),
                    UnitCost = reader.GetDecimal("unit_cost")
                });
            }
            return items;
        }

        // ---------- Confirm purchase (stock increases) ----------

        /// <summary>
        /// Confirms a Draft purchase: locks it from further edits and increases
        /// stock for every line item. Runs as a single transaction so totals,
        /// status and stock levels never get out of sync.
        /// </summary>
        public bool ConfirmPurchase(int purchaseId)
        {
            using var conn = DatabaseConnection.GetConnection();
            using var tx = conn.BeginTransaction();
            try
            {
                var items = new List<(int productId, int qty)>();
                using (var cmd = new MySqlCommand(
                    "SELECT product_id, quantity FROM purchase_items WHERE purchase_id=@id", conn, tx))
                {
                    cmd.Parameters.AddWithValue("@id", purchaseId);
                    using var reader = cmd.ExecuteReader();
                    while (reader.Read())
                        items.Add((reader.GetInt32("product_id"), reader.GetInt32("quantity")));
                }

                if (items.Count == 0)
                    throw new InvalidOperationException("Cannot confirm a purchase with no items.");

                using (var cmd = new MySqlCommand(
                    "UPDATE purchases SET status='Confirmed' WHERE purchase_id=@id AND status='Draft'", conn, tx))
                {
                    cmd.Parameters.AddWithValue("@id", purchaseId);
                    int affected = cmd.ExecuteNonQuery();
                    if (affected == 0)
                        throw new InvalidOperationException("Purchase is not in Draft status - it may already be confirmed.");
                }

                foreach (var (productId, qty) in items)
                    _productLookup.AdjustStock(productId, qty, conn, tx); // Stock +

                tx.Commit();
                return true;
            }
            catch
            {
                tx.Rollback();
                throw;
            }
        }

        // ---------- Purchase return (stock decreases) ----------

        public int RecordPurchaseReturn(PurchaseReturn purchaseReturn)
        {
            using var conn = DatabaseConnection.GetConnection();
            using var tx = conn.BeginTransaction();
            try
            {
                int newId;
                const string sql = @"INSERT INTO purchase_returns (purchase_item_id, product_id, quantity_returned, unit_cost, reason, return_date)
                                      VALUES (@itemId, @productId, @qty, @cost, @reason, NOW());
                                      SELECT LAST_INSERT_ID();";
                using (var cmd = new MySqlCommand(sql, conn, tx))
                {
                    cmd.Parameters.AddWithValue("@itemId", purchaseReturn.PurchaseItemId);
                    cmd.Parameters.AddWithValue("@productId", purchaseReturn.ProductId);
                    cmd.Parameters.AddWithValue("@qty", purchaseReturn.QuantityReturned);
                    cmd.Parameters.AddWithValue("@cost", purchaseReturn.UnitCost);
                    cmd.Parameters.AddWithValue("@reason", purchaseReturn.Reason ?? "");
                    newId = Convert.ToInt32(cmd.ExecuteScalar());
                }

                _productLookup.AdjustStock(purchaseReturn.ProductId, -purchaseReturn.QuantityReturned, conn, tx); // Stock -

                tx.Commit();
                return newId;
            }
            catch
            {
                tx.Rollback();
                throw;
            }
        }

        public List<PurchaseReturn> GetReturnsForPurchase(int purchaseId)
        {
            var returns = new List<PurchaseReturn>();
            const string sql = @"SELECT pr.*, prod.name AS product_name FROM purchase_returns pr
                                  JOIN purchase_items pi ON pi.purchase_item_id = pr.purchase_item_id
                                  LEFT JOIN products prod ON prod.product_id = pr.product_id
                                  WHERE pi.purchase_id = @id
                                  ORDER BY pr.return_date DESC";
            using var conn = DatabaseConnection.GetConnection();
            using var cmd = new MySqlCommand(sql, conn);
            cmd.Parameters.AddWithValue("@id", purchaseId);
            using var reader = cmd.ExecuteReader();
            while (reader.Read())
            {
                returns.Add(new PurchaseReturn
                {
                    PurchaseReturnId = reader.GetInt32("purchase_return_id"),
                    PurchaseItemId = reader.GetInt32("purchase_item_id"),
                    ProductId = reader.GetInt32("product_id"),
                    ProductName = reader["product_name"]?.ToString() ?? "(unknown product)",
                    QuantityReturned = reader.GetInt32("quantity_returned"),
                    UnitCost = reader.GetDecimal("unit_cost"),
                    Reason = reader["reason"]?.ToString(),
                    ReturnDate = reader.GetDateTime("return_date")
                });
            }
            return returns;
        }

        // ---------- Reporting ----------

        public decimal GetTotalPurchasesInRange(DateTime from, DateTime to)
        {
            const string sql = @"SELECT COALESCE(SUM(total_amount),0) FROM purchases
                                  WHERE status='Confirmed' AND purchase_date BETWEEN @from AND @to";
            using var conn = DatabaseConnection.GetConnection();
            using var cmd = new MySqlCommand(sql, conn);
            cmd.Parameters.AddWithValue("@from", from);
            cmd.Parameters.AddWithValue("@to", to);
            return Convert.ToDecimal(cmd.ExecuteScalar());
        }

        // ---------- helpers ----------

        private void RecalculateTotal(int purchaseId, MySqlConnection conn)
        {
            const string sql = @"UPDATE purchases SET total_amount =
                                  (SELECT COALESCE(SUM(quantity*unit_cost),0) FROM purchase_items WHERE purchase_id=@id)
                                  WHERE purchase_id=@id";
            using var cmd = new MySqlCommand(sql, conn);
            cmd.Parameters.AddWithValue("@id", purchaseId);
            cmd.ExecuteNonQuery();
        }

        private int GetPurchaseIdForItem(int purchaseItemId, MySqlConnection conn)
        {
            using var cmd = new MySqlCommand("SELECT purchase_id FROM purchase_items WHERE purchase_item_id=@id", conn);
            cmd.Parameters.AddWithValue("@id", purchaseItemId);
            var result = cmd.ExecuteScalar();
            return result == null ? 0 : Convert.ToInt32(result);
        }

        private Purchase MapPurchase(MySqlDataReader reader)
        {
            return new Purchase
            {
                PurchaseId = reader.GetInt32("purchase_id"),
                SupplierId = reader.GetInt32("supplier_id"),
                SupplierName = reader["supplier_name"]?.ToString(),
                RecordedByUserId = reader.GetInt32("recorded_by_user_id"),
                PurchaseDate = reader.GetDateTime("purchase_date"),
                Status = Enum.Parse<PurchaseStatus>(reader.GetString("status")),
                TotalAmount = reader.GetDecimal("total_amount"),
                Notes = reader["notes"]?.ToString()
            };
        }
    }
}

