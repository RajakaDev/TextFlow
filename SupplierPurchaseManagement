using System;

namespace SupplierPurchaseManagement.Models
{
    public class PurchaseReturn
    {
        public int PurchaseReturnId { get; set; }
        public int PurchaseItemId { get; set; }
        public int ProductId { get; set; }
        public string ProductName { get; set; }
        public int QuantityReturned { get; set; }
        public decimal UnitCost { get; set; }
        public string Reason { get; set; }
        public DateTime ReturnDate { get; set; } = DateTime.Now;

        public decimal RefundAmount => QuantityReturned * UnitCost;
    }
}

using System;
using System.Collections.Generic;

namespace SupplierPurchaseManagement.Models
{
    public enum PurchaseStatus
    {
        Draft,      // unconfirmed - editable / deletable
        Confirmed,  // stock has been increased
        Cancelled
    }

    public class Purchase
    {
        public int PurchaseId { get; set; }
        public int SupplierId { get; set; }
        public string SupplierName { get; set; } // convenience for grid display
        public int RecordedByUserId { get; set; } // FK -> users table (Fernando's module)
        public DateTime PurchaseDate { get; set; } = DateTime.Now;
        public PurchaseStatus Status { get; set; } = PurchaseStatus.Draft;
        public decimal TotalAmount { get; set; }
        public string Notes { get; set; }

        public List<PurchaseItem> Items { get; set; } = new List<PurchaseItem>();

        public decimal CalculateTotal()
        {
            decimal total = 0;
            foreach (var item in Items)
                total += item.LineTotal;
            TotalAmount = total;
            return total;
        }
    }
}

using System;

namespace SupplierPurchaseManagement.Models
{
    public class Supplier
    {
        public int SupplierId { get; set; }
        public string Name { get; set; }
        public string ContactPerson { get; set; }
        public string Phone { get; set; }
        public string Email { get; set; }
        public string Address { get; set; }
        public bool IsActive { get; set; } = true;
        public DateTime CreatedAt { get; set; }

        public override string ToString() => Name;
    }
}

namespace SupplierPurchaseManagement.Models
{
    public class PurchaseItem
    {
        public int PurchaseItemId { get; set; }
        public int PurchaseId { get; set; }
        public int ProductId { get; set; }        // FK -> products table (Anurasiri's module)
        public string ProductName { get; set; }    // convenience for grid display, read-only lookup
        public string Barcode { get; set; }
        public int Quantity { get; set; }
        public decimal UnitCost { get; set; }

        public decimal LineTotal => Quantity * UnitCost;
    }
}

using System;
using System.Drawing;
using System.Windows.Forms;
using SupplierPurchaseManagement.DAO;
using SupplierPurchaseManagement.Models;

namespace SupplierPurchaseManagement.Forms
{
    public class SupplierForm : Form
    {
        private readonly SupplierDAO _supplierDAO = new SupplierDAO();

        private DataGridView grid;
        private TextBox txtName, txtContact, txtPhone, txtEmail, txtAddress, txtSearch;
        private Button btnAdd, btnUpdate, btnDeactivate, btnClear, btnSearch;
        private int? selectedSupplierId = null;

        public SupplierForm()
        {
            Text = "Manage Suppliers";
            Width = 900;
            Height = 560;
            StartPosition = FormStartPosition.CenterScreen;

            BuildUi();
            LoadSuppliers();
        }

        private void BuildUi()
        {
            var lblSearch = new Label { Text = "Search:", Left = 20, Top = 15, Width = 60 };
            txtSearch = new TextBox { Left = 80, Top = 12, Width = 200 };
            btnSearch = new Button { Text = "Search", Left = 290, Top = 10, Width = 80 };
            btnSearch.Click += (s, e) => LoadSuppliers(txtSearch.Text.Trim());

            grid = new DataGridView
            {
                Left = 20,
                Top = 50,
                Width = 840,
                Height = 260,
                ReadOnly = true,
                AllowUserToAddRows = false,
                SelectionMode = DataGridViewSelectionMode.FullRowSelect,
                MultiSelect = false,
                AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill
            };
            grid.SelectionChanged += Grid_SelectionChanged;

            int formTop = 330;
            var lblName = new Label { Text = "Name*:", Left = 20, Top = formTop, Width = 90 };
            txtName = new TextBox { Left = 120, Top = formTop - 3, Width = 250 };

            var lblContact = new Label { Text = "Contact Person:", Left = 400, Top = formTop, Width = 100 };
            txtContact = new TextBox { Left = 510, Top = formTop - 3, Width = 250 };

            int row2 = formTop + 35;
            var lblPhone = new Label { Text = "Phone:", Left = 20, Top = row2, Width = 90 };
            txtPhone = new TextBox { Left = 120, Top = row2 - 3, Width = 250 };

            var lblEmail = new Label { Text = "Email:", Left = 400, Top = row2, Width = 100 };
            txtEmail = new TextBox { Left = 510, Top = row2 - 3, Width = 250 };

            int row3 = row2 + 35;
            var lblAddress = new Label { Text = "Address:", Left = 20, Top = row3, Width = 90 };
            txtAddress = new TextBox { Left = 120, Top = row3 - 3, Width = 640 };

            int btnTop = row3 + 40;
            btnAdd = new Button { Text = "Add Supplier", Left = 120, Top = btnTop, Width = 140, Height = 35 };
            btnAdd.Click += BtnAdd_Click;

            btnUpdate = new Button { Text = "Update Selected", Left = 270, Top = btnTop, Width = 140, Height = 35 };
            btnUpdate.Click += BtnUpdate_Click;

            btnDeactivate = new Button { Text = "Deactivate Selected", Left = 420, Top = btnTop, Width = 160, Height = 35 };
            btnDeactivate.Click += BtnDeactivate_Click;

            btnClear = new Button { Text = "Clear Form", Left = 590, Top = btnTop, Width = 120, Height = 35 };
            btnClear.Click += (s, e) => ClearForm();

            Controls.AddRange(new Control[]
            {
                lblSearch, txtSearch, btnSearch,
                grid,
                lblName, txtName, lblContact, txtContact,
                lblPhone, txtPhone, lblEmail, txtEmail,
                lblAddress, txtAddress,
                btnAdd, btnUpdate, btnDeactivate, btnClear
            });
        }

        private void LoadSuppliers(string keyword = null)
        {
            var suppliers = string.IsNullOrWhiteSpace(keyword)
                ? _supplierDAO.GetAllSuppliers()
                : _supplierDAO.SearchSuppliers(keyword);

            grid.DataSource = null;
            grid.DataSource = suppliers;

            if (grid.Columns["SupplierId"] != null) grid.Columns["SupplierId"].HeaderText = "ID";
            if (grid.Columns["ContactPerson"] != null) grid.Columns["ContactPerson"].HeaderText = "Contact";
            if (grid.Columns["IsActive"] != null) grid.Columns["IsActive"].Visible = false;
            if (grid.Columns["CreatedAt"] != null) grid.Columns["CreatedAt"].HeaderText = "Since";
        }

        private void Grid_SelectionChanged(object sender, EventArgs e)
        {
            if (grid.CurrentRow?.DataBoundItem is not Supplier supplier) return;

            selectedSupplierId = supplier.SupplierId;
            txtName.Text = supplier.Name;
            txtContact.Text = supplier.ContactPerson;
            txtPhone.Text = supplier.Phone;
            txtEmail.Text = supplier.Email;
            txtAddress.Text = supplier.Address;
        }

        private void BtnAdd_Click(object sender, EventArgs e)
        {
            if (!ValidateForm()) return;

            var supplier = new Supplier
            {
                Name = txtName.Text.Trim(),
                ContactPerson = txtContact.Text.Trim(),
                Phone = txtPhone.Text.Trim(),
                Email = txtEmail.Text.Trim(),
                Address = txtAddress.Text.Trim()
            };

            try
            {
                _supplierDAO.AddSupplier(supplier);
                MessageBox.Show("Supplier added.", "Success", MessageBoxButtons.OK, MessageBoxIcon.Information);
                ClearForm();
                LoadSuppliers();
            }
            catch (Exception ex)
            {
                MessageBox.Show("Failed to add supplier: " + ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void BtnUpdate_Click(object sender, EventArgs e)
        {
            if (selectedSupplierId == null)
            {
                MessageBox.Show("Select a supplier from the list first.");
                return;
            }
            if (!ValidateForm()) return;

            var supplier = new Supplier
            {
                SupplierId = selectedSupplierId.Value,
                Name = txtName.Text.Trim(),
                ContactPerson = txtContact.Text.Trim(),
                Phone = txtPhone.Text.Trim(),
                Email = txtEmail.Text.Trim(),
                Address = txtAddress.Text.Trim()
            };

            try
            {
                _supplierDAO.UpdateSupplier(supplier);
                MessageBox.Show("Supplier updated.", "Success", MessageBoxButtons.OK, MessageBoxIcon.Information);
                ClearForm();
                LoadSuppliers();
            }
            catch (Exception ex)
            {
                MessageBox.Show("Failed to update supplier: " + ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void BtnDeactivate_Click(object sender, EventArgs e)
        {
            if (selectedSupplierId == null)
            {
                MessageBox.Show("Select a supplier from the list first.");
                return;
            }

            var confirm = MessageBox.Show("Deactivate this supplier? It will be hidden from new purchases but past purchase history is kept.",
                "Confirm", MessageBoxButtons.YesNo, MessageBoxIcon.Question);
            if (confirm != DialogResult.Yes) return;

            _supplierDAO.DeactivateSupplier(selectedSupplierId.Value);
            ClearForm();
            LoadSuppliers();
        }

        private bool ValidateForm()
        {
            if (string.IsNullOrWhiteSpace(txtName.Text))
            {
                MessageBox.Show("Supplier name is required.", "Validation", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return false;
            }
            return true;
        }

        private void ClearForm()
        {
            selectedSupplierId = null;
            txtName.Clear();
            txtContact.Clear();
            txtPhone.Clear();
            txtEmail.Clear();
            txtAddress.Clear();
            grid.ClearSelection();
        }
    }
}

using System;
using System.Linq;
using System.Windows.Forms;
using SupplierPurchaseManagement.DAO;
using SupplierPurchaseManagement.Models;

namespace SupplierPurchaseManagement.Forms
{
    public class PurchaseForm : Form
    {
        private readonly SupplierDAO _supplierDAO = new SupplierDAO();
        private readonly PurchaseDAO _purchaseDAO = new PurchaseDAO();
        private readonly ProductLookupDAO _productDAO = new ProductLookupDAO();

        // TODO: replace with the real logged-in user id once Fernando's
        // Authentication module is wired in (e.g. CurrentUser.UserId).
        private const int CurrentUserId = 1;

        private ComboBox cmbSupplier;
        private Button btnStartPurchase, btnConfirmPurchase, btnDeletePurchase, btnReturns;
        private Label lblPurchaseInfo, lblTotal;

        private TextBox txtBarcode;
        private Button btnLookup;
        private Label lblProductFound;
        private NumericUpDown numQty;
        private TextBox txtUnitCost;
        private Button btnAddItem, btnRemoveItem;

        private DataGridView gridItems;

        private int? currentPurchaseId = null;
        private ProductLookupDAO.ProductRef lookedUpProduct = null;

        public PurchaseForm()
        {
            Text = "New / Manage Purchase";
            Width = 950;
            Height = 650;
            StartPosition = FormStartPosition.CenterScreen;

            BuildUi();
            LoadSuppliers();
            SetPurchaseControlsEnabled(false);
        }

        private void BuildUi()
        {
            var lblSupplier = new Label { Text = "Supplier:", Left = 20, Top = 18, Width = 70 };
            cmbSupplier = new ComboBox { Left = 90, Top = 15, Width = 300, DropDownStyle = ComboBoxStyle.DropDownList };

            btnStartPurchase = new Button { Text = "Start New Purchase", Left = 400, Top = 13, Width = 160, Height = 30 };
            btnStartPurchase.Click += BtnStartPurchase_Click;

            lblPurchaseInfo = new Label { Text = "No active purchase.", Left = 570, Top = 18, Width = 340, ForeColor = System.Drawing.Color.DimGray };

            // ---- Item entry group ----
            var lblBarcode = new Label { Text = "Barcode:", Left = 20, Top = 65, Width = 70 };
            txtBarcode = new TextBox { Left = 90, Top = 62, Width = 150 };
            btnLookup = new Button { Text = "Lookup", Left = 245, Top = 60, Width = 80 };
            btnLookup.Click += BtnLookup_Click;
            lblProductFound = new Label { Text = "", Left = 335, Top = 65, Width = 300, ForeColor = System.Drawing.Color.DarkGreen };

            var lblQty = new Label { Text = "Qty:", Left = 20, Top = 100, Width = 70 };
            numQty = new NumericUpDown { Left = 90, Top = 97, Width = 80, Minimum = 1, Maximum = 100000, Value = 1 };

            var lblCost = new Label { Text = "Unit Cost:", Left = 190, Top = 100, Width = 70 };
            txtUnitCost = new TextBox { Left = 265, Top = 97, Width = 100 };

            btnAddItem = new Button { Text = "Add Item to Purchase", Left = 385, Top = 95, Width = 180, Height = 30 };
            btnAddItem.Click += BtnAddItem_Click;

            gridItems = new DataGridView
            {
                Left = 20,
                Top = 140,
                Width = 890,
                Height = 320,
                ReadOnly = true,
                AllowUserToAddRows = false,
                SelectionMode = DataGridViewSelectionMode.FullRowSelect,
                MultiSelect = false,
                AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill
            };

            btnRemoveItem = new Button { Text = "Remove Selected Item", Left = 20, Top = 470, Width = 180, Height = 32 };
            btnRemoveItem.Click += BtnRemoveItem_Click;

            lblTotal = new Label
            {
                Text = "Total: 0.00",
                Left = 700,
                Top = 475,
                Width = 200,
                Font = new System.Drawing.Font("Segoe UI", 11, System.Drawing.FontStyle.Bold),
                TextAlign = System.Drawing.ContentAlignment.MiddleRight
            };

            btnConfirmPurchase = new Button { Text = "Confirm Purchase (Stock +)", Left = 20, Top = 520, Width = 220, Height = 40 };
            btnConfirmPurchase.Click += BtnConfirmPurchase_Click;

            btnDeletePurchase = new Button { Text = "Delete Draft Purchase", Left = 250, Top = 520, Width = 200, Height = 40 };
            btnDeletePurchase.Click += BtnDeletePurchase_Click;

            btnReturns = new Button { Text = "Record Purchase Return...", Left = 460, Top = 520, Width = 220, Height = 40 };
            btnReturns.Click += BtnReturns_Click;

            Controls.AddRange(new Control[]
            {
                lblSupplier, cmbSupplier, btnStartPurchase, lblPurchaseInfo,
                lblBarcode, txtBarcode, btnLookup, lblProductFound,
                lblQty, numQty, lblCost, txtUnitCost, btnAddItem,
                gridItems, btnRemoveItem, lblTotal,
                btnConfirmPurchase, btnDeletePurchase, btnReturns
            });
        }

        private void LoadSuppliers()
        {
            var suppliers = _supplierDAO.GetAllSuppliers();
            cmbSupplier.DataSource = suppliers;
            cmbSupplier.DisplayMember = "Name";
            cmbSupplier.ValueMember = "SupplierId";
        }

        private void SetPurchaseControlsEnabled(bool enabled)
        {
            txtBarcode.Enabled = enabled;
            btnLookup.Enabled = enabled;
            numQty.Enabled = enabled;
            txtUnitCost.Enabled = enabled;
            btnAddItem.Enabled = enabled;
            btnRemoveItem.Enabled = enabled;
            btnConfirmPurchase.Enabled = enabled;
            btnDeletePurchase.Enabled = enabled;
            btnReturns.Enabled = enabled;
        }

        private void BtnStartPurchase_Click(object sender, EventArgs e)
        {
            if (cmbSupplier.SelectedItem is not Supplier supplier)
            {
                MessageBox.Show("Select a supplier first.");
                return;
            }

            try
            {
                currentPurchaseId = _purchaseDAO.StartPurchase(supplier.SupplierId, CurrentUserId, "");
                lblPurchaseInfo.Text = $"Draft purchase #{currentPurchaseId} - {supplier.Name}";
                SetPurchaseControlsEnabled(true);
                RefreshItemsGrid();
            }
            catch (Exception ex)
            {
                MessageBox.Show("Could not start purchase: " + ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void BtnLookup_Click(object sender, EventArgs e)
        {
            if (string.IsNullOrWhiteSpace(txtBarcode.Text)) return;

            try
            {
                lookedUpProduct = _productDAO.FindByBarcode(txtBarcode.Text.Trim());
                lblProductFound.Text = lookedUpProduct != null
                    ? $"Found: {lookedUpProduct.Name}"
                    : "No product found for that barcode.";
                lblProductFound.ForeColor = lookedUpProduct != null
                    ? System.Drawing.Color.DarkGreen
                    : System.Drawing.Color.Red;
            }
            catch (Exception ex)
            {
                MessageBox.Show("Product lookup failed (is the shared `products` table set up?): " + ex.Message,
                    "Lookup Error", MessageBoxButtons.OK, MessageBoxIcon.Warning);
            }
        }

        private void BtnAddItem_Click(object sender, EventArgs e)
        {
            if (currentPurchaseId == null) return;

            if (lookedUpProduct == null)
            {
                MessageBox.Show("Look up a valid product barcode first.");
                return;
            }

            if (!decimal.TryParse(txtUnitCost.Text, out decimal unitCost) || unitCost < 0)
            {
                MessageBox.Show("Enter a valid unit cost.");
                return;
            }

            var item = new PurchaseItem
            {
                ProductId = lookedUpProduct.ProductId,
                Quantity = (int)numQty.Value,
                UnitCost = unitCost
            };

            try
            {
                _purchaseDAO.AddItem(currentPurchaseId.Value, item);
                txtBarcode.Clear();
                txtUnitCost.Clear();
                numQty.Value = 1;
                lblProductFound.Text = "";
                lookedUpProduct = null;
                RefreshItemsGrid();
            }
            catch (Exception ex)
            {
                MessageBox.Show("Could not add item: " + ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void BtnRemoveItem_Click(object sender, EventArgs e)
        {
            if (gridItems.CurrentRow?.DataBoundItem is not PurchaseItem item) return;

            _purchaseDAO.RemoveItem(item.PurchaseItemId);
            RefreshItemsGrid();
        }

        private void BtnConfirmPurchase_Click(object sender, EventArgs e)
        {
            if (currentPurchaseId == null) return;

            var purchase = _purchaseDAO.GetPurchaseById(currentPurchaseId.Value);
            if (purchase == null || purchase.Items.Count == 0)
            {
                MessageBox.Show("Add at least one item before confirming.");
                return;
            }

            var confirm = MessageBox.Show(
                $"Confirm this purchase? Stock will increase for {purchase.Items.Count} item(s). This cannot be undone directly (use a Purchase Return instead).",
                "Confirm Purchase", MessageBoxButtons.YesNo, MessageBoxIcon.Question);
            if (confirm != DialogResult.Yes) return;

            try
            {
                _purchaseDAO.ConfirmPurchase(currentPurchaseId.Value);
                MessageBox.Show("Purchase confirmed and stock updated.", "Success", MessageBoxButtons.OK, MessageBoxIcon.Information);
                ResetPurchaseState();
            }
            catch (Exception ex)
            {
                MessageBox.Show("Could not confirm purchase: " + ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void BtnDeletePurchase_Click(object sender, EventArgs e)
        {
            if (currentPurchaseId == null) return;

            var confirm = MessageBox.Show("Delete this draft purchase and all its items? This cannot be undone.",
                "Confirm Delete", MessageBoxButtons.YesNo, MessageBoxIcon.Warning);
            if (confirm != DialogResult.Yes) return;

            try
            {
                _purchaseDAO.DeleteUnconfirmedPurchase(currentPurchaseId.Value);
                ResetPurchaseState();
            }
            catch (Exception ex)
            {
                MessageBox.Show("Could not delete purchase: " + ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void BtnReturns_Click(object sender, EventArgs e)
        {
            if (currentPurchaseId == null) return;
            using var form = new PurchaseReturnForm(currentPurchaseId.Value);
            form.ShowDialog();
            RefreshItemsGrid();
        }

        private void RefreshItemsGrid()
        {
            if (currentPurchaseId == null) return;

            var items = _purchaseDAO.GetItemsForPurchase(currentPurchaseId.Value);
            gridItems.DataSource = null;
            gridItems.DataSource = items;

            if (gridItems.Columns["PurchaseItemId"] != null) gridItems.Columns["PurchaseItemId"].HeaderText = "ID";
            if (gridItems.Columns["PurchaseId"] != null) gridItems.Columns["PurchaseId"].Visible = false;
            if (gridItems.Columns["ProductId"] != null) gridItems.Columns["ProductId"].Visible = false;
            if (gridItems.Columns["ProductName"] != null) gridItems.Columns["ProductName"].HeaderText = "Product";
            if (gridItems.Columns["UnitCost"] != null) gridItems.Columns["UnitCost"].HeaderText = "Unit Cost";
            if (gridItems.Columns["LineTotal"] != null) gridItems.Columns["LineTotal"].HeaderText = "Line Total";

            decimal total = items.Sum(i => i.LineTotal);
            lblTotal.Text = $"Total: {total:N2}";
        }

        private void ResetPurchaseState()
        {
            currentPurchaseId = null;
            lblPurchaseInfo.Text = "No active purchase.";
            gridItems.DataSource = null;
            lblTotal.Text = "Total: 0.00";
            SetPurchaseControlsEnabled(false);
        }
    }
}

using System;
using System.Linq;
using System.Windows.Forms;
using SupplierPurchaseManagement.DAO;
using SupplierPurchaseManagement.Models;

namespace SupplierPurchaseManagement.Forms
{
    public class PurchaseReturnForm : Form
    {
        private readonly PurchaseDAO _purchaseDAO = new PurchaseDAO();
        private readonly int _purchaseId;

        private ComboBox cmbItem;
        private NumericUpDown numQty;
        private TextBox txtReason;
        private DataGridView gridReturns;
        private Button btnSubmit;

        public PurchaseReturnForm(int purchaseId)
        {
            _purchaseId = purchaseId;
            Text = $"Purchase Return - Purchase #{purchaseId}";
            Width = 620;
            Height = 500;
            StartPosition = FormStartPosition.CenterParent;

            BuildUi();
            LoadItems();
            LoadReturns();
        }

        private void BuildUi()
        {
            var lblItem = new Label { Text = "Item:", Left = 20, Top = 20, Width = 60 };
            cmbItem = new ComboBox { Left = 90, Top = 17, Width = 480, DropDownStyle = ComboBoxStyle.DropDownList };

            var lblQty = new Label { Text = "Qty to return:", Left = 20, Top = 55, Width = 90 };
            numQty = new NumericUpDown { Left = 120, Top = 52, Width = 80, Minimum = 1, Maximum = 100000 };

            var lblReason = new Label { Text = "Reason:", Left = 220, Top = 55, Width = 60 };
            txtReason = new TextBox { Left = 280, Top = 52, Width = 290 };

            btnSubmit = new Button { Text = "Record Return (Stock -)", Left = 20, Top = 90, Width = 200, Height = 32 };
            btnSubmit.Click += BtnSubmit_Click;

            gridReturns = new DataGridView
            {
                Left = 20,
                Top = 140,
                Width = 550,
                Height = 280,
                ReadOnly = true,
                AllowUserToAddRows = false,
                AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill
            };

            Controls.AddRange(new Control[] { lblItem, cmbItem, lblQty, numQty, lblReason, txtReason, btnSubmit, gridReturns });
        }

        private void LoadItems()
        {
            var items = _purchaseDAO.GetItemsForPurchase(_purchaseId);
            cmbItem.DataSource = items;
            cmbItem.DisplayMember = "ProductName";
            cmbItem.ValueMember = "PurchaseItemId";
        }

        private void LoadReturns()
        {
            var returns = _purchaseDAO.GetReturnsForPurchase(_purchaseId);
            gridReturns.DataSource = null;
            gridReturns.DataSource = returns;

            if (gridReturns.Columns["PurchaseReturnId"] != null) gridReturns.Columns["PurchaseReturnId"].HeaderText = "ID";
            if (gridReturns.Columns["PurchaseItemId"] != null) gridReturns.Columns["PurchaseItemId"].Visible = false;
            if (gridReturns.Columns["ProductId"] != null) gridReturns.Columns["ProductId"].Visible = false;
            if (gridReturns.Columns["ProductName"] != null) gridReturns.Columns["ProductName"].HeaderText = "Product";
            if (gridReturns.Columns["QuantityReturned"] != null) gridReturns.Columns["QuantityReturned"].HeaderText = "Qty";
            if (gridReturns.Columns["RefundAmount"] != null) gridReturns.Columns["RefundAmount"].HeaderText = "Refund";
        }

        private void BtnSubmit_Click(object sender, EventArgs e)
        {
            if (cmbItem.SelectedItem is not PurchaseItem item)
            {
                MessageBox.Show("Select an item to return.");
                return;
            }

            if (numQty.Value > item.Quantity)
            {
                MessageBox.Show($"Cannot return more than the purchased quantity ({item.Quantity}).");
                return;
            }

            var purchaseReturn = new PurchaseReturn
            {
                PurchaseItemId = item.PurchaseItemId,
                ProductId = item.ProductId,
                QuantityReturned = (int)numQty.Value,
                UnitCost = item.UnitCost,
                Reason = txtReason.Text.Trim()
            };

            try
            {
                _purchaseDAO.RecordPurchaseReturn(purchaseReturn);
                MessageBox.Show("Return recorded and stock decreased.", "Success", MessageBoxButtons.OK, MessageBoxIcon.Information);
                txtReason.Clear();
                numQty.Value = 1;
                LoadReturns();
            }
            catch (Exception ex)
            {
                MessageBox.Show("Could not record return: " + ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }
    }
}

