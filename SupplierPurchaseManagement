        private const string Database = "pos_system";
        private const string User = "root";
        private const string Password = "";

        private static string ConnectionString =>
            $"Server={Server};Port={Port};Database={Database};Uid={User};Pwd={Password};SslMode=none;";

        /// <summary>
        /// Returns a new, already-open MySqlConnection. Caller is responsible
        /// for disposing it (use a `using` block).
        /// </summary>
        public static MySqlConnection GetConnection()
        {
            var connection = new MySqlConnection(ConnectionString);
            connection.Open();
            return connection;
        }

